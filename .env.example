# MOSS-VL MCP configuration template.
# Copy these environment variables into your shell or MCP client config.
# The server reads them on startup; it does not automatically load .env files.

# Set a narrow directory containing media intentionally shared with agents.
MOSS_VL_MEDIA_ROOT=/absolute/path/to/allowed/media

# Offline model checkpoint; ensure upstream model dependencies are installed.
MOSS_VL_CHECKPOINT=OpenMOSS-Team/MOSS-VL-Instruct-0708

# Reference MOSS-VL-Realtime server (not SGLang-Omni).
MOSS_VL_REALTIME_URL=ws://127.0.0.1:8000/v1/realtime
MOSS_VL_MAX_SESSIONS=1

# Opt-in only: video must be available at the same absolute path on model host.
MOSS_VL_ALLOW_SERVER_VIDEO=0

# Opt-in only: captures the screen of the MCP host (may include secrets).
# Requires pip install -e '.[screen]'
MOSS_VL_ALLOW_SCREEN_CAPTURE=0
